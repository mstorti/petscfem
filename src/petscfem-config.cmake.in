@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Esto automatiza la búsqueda para cualquier aplicación que use petscfem
if(NOT TARGET jsoncpp_lib)
  # Pasamos la variable jsoncpp_DIR configurada durante la compilación de petscfem
  set(jsoncpp_DIR "@jsoncpp_DIR@")
  find_dependency(jsoncpp REQUIRED CONFIG)
endif()

find_dependency(MPI COMPONENTS C CXX Fortran)
find_dependency(X11)
find_dependency(PkgConfig)
pkg_check_modules(GLIB REQUIRED glib-2.0)

include("${CMAKE_CURRENT_LIST_DIR}/petscfemTargets.cmake")

check_required_components(petscfem)
